{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node10", "ignoreDeprecations": "5.0",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "outDir": "dist", "types": ["node"],
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test", "vitest.config.ts"]
}
