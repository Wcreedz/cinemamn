# MongolFlix орчны хувьсагчууд. .env болгон хуулж бөглөнө. .env-г хэзээ ч commit хийхгүй.
# Нууц түлхүүр үүсгэх: openssl rand -base64 48

NODE_ENV=development
PORT=4100

MONGODB_URI=mongodb://127.0.0.1:27017/mongolflix

JWT_ACCESS_SECRET=
PLAYBACK_TOKEN_SECRET=
# Nginx auth_request болон API хоорондын нууц
INTERNAL_AUTH_SECRET=

# ----- Хост/домэйн -----
CORS_ORIGINS=http://localhost:3110
COOKIE_DOMAIN=
# production дээр автоматаар true
COOKIE_SECURE=
# Nginx-ийн ард ажиллавал 1
TRUST_PROXY=0
PUBLIC_VIDEO_BASE_URL=http://localhost:4100
PUBLIC_MEDIA_BASE_URL=http://localhost:4100/media
API_INTERNAL_URL=http://localhost:4100

# ----- QPay (quickqpaypackv2) -----
# Сан хаягаа энэ хувьсагчаас уншина. Нэвтрэх мэдээллийг сан өөрөө удирддаг.
QPAY_MERCHANT_SERVER=https://quickqr.qpay.mn/
# API-н гаднаас хандах хаяг. QPay callback: <UNDSEN_SERVER>/qpaycallback/<байгууллага>/<захиалга>
UNDSEN_SERVER=https://zzzcinema.mn/api
# QpayKhariltsagch/token цуглуулгууд өөр бааз дээр байвал
QPAY_MONGODB_URI=

# ----- Видео -----
# Nginx-гүй хөгжүүлэлтэд API-аас HLS өгөх (hls + постер). Production дээр false.
SERVE_HLS_FROM_API=true
VIDEO_DEFAULT_ROOT=
VIDEO_ALLOWED_ROOTS=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
